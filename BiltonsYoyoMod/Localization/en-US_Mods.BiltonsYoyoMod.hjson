Configs: {
	YoyoConfig: {
		DisplayName: Yoyo Mod Settings

		StorageUI: {
			Label: Storage UI style
			Tooltip: Standard is the current panel. Fancy is a gold-trimmed relic look.
		}

		BetterBook: {
			Label: Better Book
			Tooltip: Adds the chapter index, Back history, search snippets, wheel paging, a reading-progress line and a dimmed backdrop. The old catalogue skin is retired; the tome itself is always used.
		}

		WildStringSpeed: {
			Label: Wild string spin speed
			Tooltip: Scales ALL Wild String rotation. 1 is normal. Lower calms the ropes, higher whips them.
		}

		SplicerAutoCombatBoard: {
			Label: Auto-open Combat board in boss fights
			Tooltip: When a boss is alive, opening the Splicer starts on COMBAT if that board has a carried yoyo. Disable to keep the remembered board.
		}

		TonicHud: {
			Label: Show tonic HUD
			Tooltip: Compact right-edge strip listing the five yoyo tonics. LMB drinks when the dose would not be wasted; RMB toggles that tonic's auto upkeep.
		}

		Headers: {
			Paintings: Paintings Header
			Visuals: Visuals Header
			Storage: Storage Header
			StringSplicer: String Splicer Header
			TonicSpool: Tonic Spool Header
