	ThrowableYoyoTech: {
		DisplayName: Throwable Yoyo Tech
		Tooltip:
			'''
			Hold and use: yoyos become heavy ember throws at 1.5x
			Gravity + bounces; Glove fans a triple spread
			Only one tech at a time; missing item = OFF
			Never consumed; Cycle Tech hotkey works too
			'''
	}

	SwingYoyoTech: {
		DisplayName: Swing Yoyo Tech
		Tooltip:
			'''
			Hold and use: yoyos swing Tinkerer arcs at 2x damage
			Full spin with Glove, wider with counterweights
			Only one tech at a time; missing item = OFF
			Never consumed; Cycle Tech hotkey works too
			'''
	}

	MagicalYoyoTech: {
		DisplayName: Magical Yoyo Tech
		Tooltip:
			'''
			Click to spawn an orbiting mirror guard (4 mana); 2 with a Yoyo Glove
			Guards space themselves evenly; cap 3, or 6 with a Yoyo Glove
			Guard life: 1/10 of the yoyo's flight time (20s if infinite)
			Yoyo damage% boosts guard life and orbit speed
			Hold right-click: Orbital Convergence - pays a start cost
			then drains a per-second upkeep while it charges and fires
			Only one tech at a time; missing item = OFF; never consumed
			'''
	}

	SummonYoyoTech: {
		DisplayName: Summon Yoyo Tech
		Tooltip:
			'''
			Hold and use: yoyos become minions at 0.6x damage
			Cap: 1 + slots + glove/counterweight/string
			Linger 5 min after off/switch; buff dismisses all
			Never consumed; Cycle Tech hotkey works too
			'''
	}

