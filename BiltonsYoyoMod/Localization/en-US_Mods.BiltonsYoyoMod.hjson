			Right-click in inventory for ON/OFF, never consumed
			'''
	}

	StringSplicer: {
		DisplayName: String Splicer
		Tooltip:
			'''
			Use or Swap Yoyo (C): next yoyo in the inventory
			Right-click: previous yoyo
			Pulls a yoyo into the hotbar if none is ready
			'''
	}

	YoyoHook: {
		DisplayName: Yoyo Hook
		Tooltip:
			'''
			Momentum grapple: swing on the rope instead of being reeled in
			Equip in the grappling hook slot, or use from the hotbar
			Attached: W/S shorten or extend the rope, A/D steer the swing
			Jump or use again to detach and keep your momentum
			'''
	}
