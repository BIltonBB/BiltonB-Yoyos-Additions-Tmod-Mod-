		}

		DarkMageRitualCooldownSeconds: {
			Label: Dark Mage Ritual Cooldown (seconds)
			Tooltip:
				'''
				Seconds of continuous yoyo deployment between Dark Mage ritual seals.
				Lower values overlap more seals (and their homing bolts). 2 is the mod default; the old hardcoded value was 20.
				'''
		}

		HPMultiplier: {
			Label: H P Multiplier
			Tooltip: ""
		}

