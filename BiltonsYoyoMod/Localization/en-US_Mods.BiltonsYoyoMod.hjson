			Label: Other Mod Yoyos Get Abilities
			Tooltip: ""
		}

		GroundFault: {
			Label: Ground Fault Mode
			Tooltip:
				'''
				Concept switch for the Ground Fault lightning ability.
				GroundHugger follows the surface under the bolt and arcs upward at enemies.
				GravityBounce gives the bolt real gravity and tile bounces. No Ground Fault ability is implemented yet.
				'''
		}
	}

